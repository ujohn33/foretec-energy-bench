[Unit]
Description=Foretec Energy Bench: relegation check (models that cost much and are clearly beaten stop running live)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=foretec
WorkingDirectory=/srv/foretec/foretec-live
Environment=FORETEC_HOME=/srv/foretec/foretec-live
Environment=HF_HOME=/srv/foretec/.hf-cache
Environment=PYTHONWARNINGS=ignore::FutureWarning
EnvironmentFile=-/srv/foretec/foretec.env
# API keys (OPENMETEOKEY, ENTSOE_TOKEN, NED_NL_KEY, RTE_DATA_KEY), read by systemd as root before dropping to User=
EnvironmentFile=-/root/.env
ExecStart=/srv/foretec/venv/bin/foretec-live relegate --apply
TimeoutStartSec=30min
Nice=5
