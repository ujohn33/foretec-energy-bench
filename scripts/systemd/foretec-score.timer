[Unit]
Description=Foretec Energy Open: daily scoring after day-ahead prices are published

[Timer]
# day-ahead results are out ~12:45-13:00; the evening pass catches late publications
OnCalendar=*-*-* 14:45:00 Europe/Brussels
OnCalendar=*-*-* 20:45:00 Europe/Brussels
Persistent=true

[Install]
WantedBy=timers.target
